SECRET_KEY=change-this-development-secret-key
DEBUG=True

# Em Codespaces, * é suficiente para a demonstração. Restrinja em produção.
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://localhost:8000,http://localhost:8000

# Reservado para a futura migração para PostgreSQL.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
