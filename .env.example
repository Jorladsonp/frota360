# Gere uma chave nova para qualquer ambiente que não seja apenas local:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Em produção, SECRET_KEY é obrigatória. Em desenvolvimento, pode ficar vazia.
SECRET_KEY=
DEBUG=True

# No Codespaces, o hostname público da porta 8000 é incluído automaticamente.
# Para produção, informe os domínios separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost:8000,http://localhost:8000

# Reservado para a futura migração para PostgreSQL.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=frota
# DB_USERNAME=frota
# DB_PASSWORD=change-me

# Serviços como Render, Railway e Heroku geralmente fornecem esta variável
# para PostgreSQL. Quando definida, ela tem prioridade sobre as variáveis DB_*.
# DATABASE_URL=postgresql://usuario:senha@host:5432/frota
# DB_CONN_MAX_AGE=600
